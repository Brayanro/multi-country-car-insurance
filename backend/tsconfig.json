{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "src/admin"]
}
